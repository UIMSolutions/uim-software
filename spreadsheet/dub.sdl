name "spreadsheet"
description "Spreadsheet analytics service inspired by Tableau, built with D and vibe.d"
authors "Ozan Nurettin Suel"
copyright "Copyright (c) 2018-2026, Ozan Nurettin Suel"
license "Apache-2.0"
targetName "uim-spreadsheet-platform-service"

dependency "uim-framework" version="~>26.4.1"
dependency "core" path="../core"

sourcePaths "source"
importPaths "source"

configuration "defaultRun" {
    targetType "executable"
}

configuration "defaultTest" {
    targetType "library"
}
