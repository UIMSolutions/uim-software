// Metadata
name "defense"
description "Defense & Security service based on SAP S/4HANA Defense & Security concepts"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

// Target
targetName "uim-defense-platform-service"

// Dependencies
dependency "uim-framework" version="~>26.4.1"
dependency "uim-platform:core" path=".."

// Source files
sourcePaths "source"
importPaths "source"

configuration "defaultRun" {
    targetType "executable"
}

configuration "defaultTest" {
    targetType "library"
}
