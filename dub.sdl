// Metadata
name "uim-platform"
description "UIM Plattform"
homepage "https://www.....de/uim/platform"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

// Target
targetType "library"
targetName "uim-platform"

// External dependencies
dependency "uim-framework" version="~>26.7.1"
dependency "vibe-d" version="~>0.10.3"
dependency "gtk-d" version="~>3.11.0"

// Internal Dependencies
dependency ":service" version="*"
// dependency ":abap-compiler" version="*"

// Source files
sourceFiles "./source/uim/software/all.d"

// Subpackages
subPackage "service"
// subPackage "abap-compiler"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"